# Copy to .env and fill in your own values. Never commit .env.
NOTION_TOKEN=replace_with_your_notion_integration_token
MOON_ROOT_PAGE_ID=replace_with_your_root_page_id
# Render the moon for noon in this UTC offset (default: UTC).
MOON_UTC_OFFSET=+00:00
# Optional: otherwise ~/.local/share/moon-icons/state.json
# MOON_STATE=/absolute/path/to/state.json
