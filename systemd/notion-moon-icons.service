[Unit]
Description=Update Notion journal moon icons

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/notion-moon-icons
EnvironmentFile=%h/.local/share/notion-moon-icons/.env
ExecStart=%h/.local/share/notion-moon-icons/.venv/bin/python -m notion_moon_icons
ExecStopPost=%h/.local/share/notion-moon-icons/.venv/bin/python -m notion_moon_icons.notifications --failure
TimeoutStartSec=10min
